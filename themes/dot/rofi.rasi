/* VoxOS - launcher i menu (rofi), motyw "dot" */
configuration {
    modi: "drun,run";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "APLIKACJE";
    display-run: "KOMENDA";
    drun-display-format: "{name}";
    font: "Space Mono 11";
}

* {
    black: #000000;
    surface: #111111;
    line: #2A2A2A;
    dim: #5A5A5A;
    text: #EDEDED;
    red: #D71921;

    background-color: transparent;
    text-color: @text;
}

window {
    width: 560px;
    background-color: #000000F2;
    border: 1px;
    border-color: @line;
    border-radius: 26px;
    padding: 20px;
}

mainbox {
    spacing: 14px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @surface;
    border: 1px;
    border-color: @line;
    border-radius: 22px;
    padding: 12px 18px;
    spacing: 14px;
    children: [ prompt, entry ];
}

prompt {
    font: "VoxDot Bold 13";
    text-color: @red;
}

entry {
    placeholder: "szukaj";
    placeholder-color: @dim;
    cursor: text;
}

listview {
    lines: 8;
    columns: 1;
    spacing: 4px;
    scrollbar: false;
    fixed-height: false;
}

element {
    padding: 10px 16px;
    border-radius: 18px;
    spacing: 14px;
    cursor: pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @text;
}

element selected.normal {
    background-color: @text;
    text-color: @black;
}

element normal.urgent,
element selected.urgent {
    text-color: @red;
}

element-icon {
    size: 22px;
    cursor: inherit;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    cursor: inherit;
}
