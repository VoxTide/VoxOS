// VoxOS - pasek (Waybar), motyw "dot"
{
    "layer": "top",
    "height": 38,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 8,
    "modules-left": [
        "custom/dot",
        "hyprland/workspaces",
        "group/active",
        "custom/minimized"
    ],
    "modules-center": [
        "clock",
        "mpris"
    ],
    "modules-right": [
        "custom/updates",
        "tray",
        "group/controls"
    ],
    "custom/dot": {
        "format": "󰝥",
        "tooltip": false,
        "on-click": "rofi -show drun"
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "󰝥",
            "urgent": "󰝥",
            "default": "󰧟",
            "empty": "󰝦"
        },
        "persistent-workspaces": {
            "*": 5
        },
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
    },
    "group/active": {
        "orientation": "horizontal",
        "modules": [
            "hyprland/window",
            "custom/close"
        ]
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 45,
        "icon": true,
        "icon-size": 16,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "$1",
            "(.*) - Visual Studio Code": "$1"
        },
        "on-click": "bash ~/.local/bin/voxos-minimize",
        "tooltip-format": "{title}\nKliknij, aby zminimalizować (Super + M)"
    },
    "custom/close": {
        "format": "󰅖",
        "tooltip-format": "Zamknij okno (Super + Q)",
        "on-click": "hyprctl dispatch 'hl.dsp.window.close()'"
    },
    "custom/minimized": {
        "exec": "bash ~/.local/bin/voxos-minimize count",
        "return-type": "json",
        "interval": 10,
        "signal": 9,
        "format": "󰖰 {}",
        "hide-empty-text": true,
        "on-click": "bash ~/.local/bin/voxos-minimize restore"
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%d.%m  %a}",
        "locale": "pl_PL.UTF-8",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<span color='#D71921'><b>{}</b></span>"
            }
        }
    },
    "group/controls": {
        "orientation": "horizontal",
        "modules": [
            "network",
            "bluetooth",
            "pulseaudio",
            "custom/battery"
        ],
        "on-click": "python3 ~/.local/bin/voxos-panel"
    },
    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰤮",
        "format-disabled": "󰤮",
        "format-icons": [
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "tooltip-format-disconnected": "Brak sieci",
        "tooltip-format-disabled": "Wi-Fi wyłączone",
        "on-click": "python3 ~/.local/bin/voxos-panel"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-on": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "format-no-controller": "",
        "tooltip-format": "Bluetooth: {status}",
        "tooltip-format-connected": "Bluetooth: {device_alias}",
        "on-click": "python3 ~/.local/bin/voxos-panel"
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰖁",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ],
            "headphone": "󰋋"
        },
        "tooltip-format": "Głośność {volume}%  ({desc})\nKółko: zmiana  Prawy: wycisz",
        "on-click": "python3 ~/.local/bin/voxos-panel",
        "on-click-right": "bash ~/.local/bin/voxos-osd volume mute",
        "on-scroll-up": "bash ~/.local/bin/voxos-osd volume up",
        "on-scroll-down": "bash ~/.local/bin/voxos-osd volume down",
        "smooth-scrolling-threshold": 1
    },
    "custom/battery": {
        "exec": "python3 ~/.local/bin/voxos-battery-info",
        "return-type": "json",
        "interval": 20,
        "format": "{text}",
        "format-alt": "{alt}",
        "format-alt-click": 1
    },
    "tray": {
        "spacing": 12,
        "icon-size": 15,
        "ignore-list": [
            "nm-applet",
            "nm-signal",
            "nm-device",
            "nm-no-connection",
            "blueman",
            "kdeconnect"
        ]
    },
    "custom/updates": {
        "exec": "bash ~/.local/bin/voxos-updates",
        "return-type": "json",
        "interval": 1800,
        "format": "󰚰 {}",
        "on-click": "kitty --title Aktualizacja sh -c 'yay -Syu; pkill -RTMIN+8 waybar; echo; read -rp \"Enter zamyka okno \"'",
        "signal": 8,
        "hide-empty-text": true
    },
    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "dynamic-order": [
            "title",
            "artist"
        ],
        "dynamic-len": 32,
        "player-icons": {
            "default": "󰐊",
            "firefox": "󰈹",
            "spotify": "󰓇",
            "mpv": "󰝚"
        },
        "status-icons": {
            "paused": "󰏤"
        },
        "tooltip-format": "{player}: {title} - {artist}\nKlik: pauza  Prawy: następny",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next"
    }
}
