// VoxOS - pasek (Waybar), motyw "dot"
{
    "layer": "top",
    "height": 38,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 8,
    "modules-left": [
        "custom/dot",
        "hyprland/workspaces",
        "group/active"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/updates",
        "backlight",
        "pulseaudio",
        "network",
        "battery",
        "tray",
        "custom/power"
    ],
    "custom/dot": {
        "format": "󰝥",
        "tooltip": false,
        "on-click": "rofi -show drun"
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "󰝥",
            "urgent": "󰝥",
            "default": "󰧟",
            "empty": "󰝦"
        },
        "persistent-workspaces": {
            "*": 5
        },
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
    },
    "group/active": {
        "orientation": "horizontal",
        "modules": [
            "hyprland/window",
            "custom/close"
        ]
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 45,
        "icon": true,
        "icon-size": 16,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "$1",
            "(.*) - Visual Studio Code": "$1"
        }
    },
    "custom/close": {
        "format": "󰅖",
        "tooltip-format": "Zamknij okno (Super + Q)",
        "on-click": "hyprctl dispatch 'hl.dsp.window.close()'"
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%d.%m  %a}",
        "locale": "pl_PL.UTF-8",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<span color='#D71921'><b>{}</b></span>"
            }
        }
    },
    "backlight": {
        "format": "{icon} {percent}",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ],
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    "pulseaudio": {
        "format": "{icon} {volume}",
        "format-muted": "󰖁 0",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ],
            "headphone": "󰋋"
        },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "network": {
        "format-wifi": "{icon}",
        "format-icons": [
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "on-click": "nm-connection-editor"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "format-charging": "󰂄 {capacity}",
        "format-plugged": "󰚥 {capacity}",
        "tooltip-format": "{timeTo}"
    },
    "tray": {
        "spacing": 10,
        "icon-size": 15
    },
    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "bash ~/.local/bin/voxos-power"
    },
    "custom/updates": {
        "exec": "bash ~/.local/bin/voxos-updates",
        "return-type": "json",
        "interval": 1800,
        "format": "󰚰 {}",
        "on-click": "kitty --title Aktualizacja sh -c 'yay -Syu; pkill -RTMIN+8 waybar; echo; read -rp \"Enter zamyka okno \"'",
        "signal": 8
    }
}
