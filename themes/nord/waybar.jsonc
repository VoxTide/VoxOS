// VoxOS - pasek (Waybar), motyw Nord. Ikony: JetBrainsMono Nerd Font
{
    "layer": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 6,
    "modules-left": [
        "custom/arch",
        "hyprland/workspaces",
        "group/active"
    ],
    "modules-center": [
        "clock",
        "mpris"
    ],
    "modules-right": [
        "custom/updates",
        "group/controls",
        "battery",
        "custom/power"
    ],
    "custom/arch": {
        "format": "",
        "tooltip": false,
        "on-click": "rofi -show drun"
    },
    "hyprland/workspaces": {
        "format": "{id}",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
    },
    "group/active": {
        "orientation": "horizontal",
        "modules": [
            "hyprland/window",
            "custom/close"
        ]
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 45,
        "icon": true,
        "icon-size": 16,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "$1",
            "(.*) - Visual Studio Code": "$1"
        }
    },
    "custom/close": {
        "format": "󰅖",
        "tooltip-format": "Zamknij okno (Super + Q)",
        "on-click": "hyprctl dispatch 'hl.dsp.window.close()'"
    },
    "clock": {
        "format": "󰅐  {:%H:%M}",
        "format-alt": "󰃭  {:%A, %d.%m.%Y}",
        "locale": "pl_PL.UTF-8",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<span color='#88C0D0'><b>{}</b></span>"
            }
        }
    },
    "group/controls": {
        "orientation": "horizontal",
        "modules": [
            "group/light",
            "group/audio",
            "tray"
        ]
    },
    "group/light": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 250,
            "transition-left-to-right": false
        },
        "modules": [
            "backlight",
            "backlight/slider"
        ]
    },
    "group/audio": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 250,
            "transition-left-to-right": false
        },
        "modules": [
            "pulseaudio",
            "pulseaudio/slider"
        ]
    },
    "backlight": {
        "format": "{icon}  {percent}%",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ],
        "on-scroll-up": "bash ~/.local/bin/voxos-osd brightness up",
        "on-scroll-down": "bash ~/.local/bin/voxos-osd brightness down",
        "tooltip-format": "Jasność {percent}%\nKółko lub suwak: zmiana",
        "smooth-scrolling-threshold": 1
    },
    "backlight/slider": {
        "min": 5,
        "max": 100,
        "orientation": "horizontal"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰖁  wycisz.",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ],
            "headphone": "󰋋"
        },
        "on-click": "pavucontrol",
        "on-click-right": "bash ~/.local/bin/voxos-osd volume mute",
        "tooltip-format": "Głośność {volume}%  ({desc})\nKółko: zmiana  Klik: mikser  Prawy: wycisz",
        "on-scroll-up": "bash ~/.local/bin/voxos-osd volume up",
        "on-scroll-down": "bash ~/.local/bin/voxos-osd volume down",
        "smooth-scrolling-threshold": 1
    },
    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal",
        "zero-on-mute": false
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰚥  {capacity}%",
        "tooltip-format": "{timeTo}"
    },
    "tray": {
        "spacing": 12,
        "icon-size": 16
    },
    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "bash ~/.local/bin/voxos-power"
    },
    "custom/updates": {
        "exec": "bash ~/.local/bin/voxos-updates",
        "return-type": "json",
        "interval": 1800,
        "format": "󰚰  {}",
        "on-click": "kitty --title Aktualizacja sh -c 'yay -Syu; pkill -RTMIN+8 waybar; echo; read -rp \"Enter zamyka okno \"'",
        "signal": 8,
        "hide-empty-text": true
    },
    "mpris": {
        "format": "{player_icon}  {dynamic}",
        "format-paused": "{status_icon}  {dynamic}",
        "dynamic-order": [
            "title",
            "artist"
        ],
        "dynamic-len": 32,
        "player-icons": {
            "default": "󰐊",
            "firefox": "󰈹",
            "spotify": "󰓇",
            "mpv": "󰝚"
        },
        "status-icons": {
            "paused": "󰏤"
        },
        "tooltip-format": "{player}: {title} - {artist}\nKlik: pauza  Prawy: następny",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next"
    }
}
