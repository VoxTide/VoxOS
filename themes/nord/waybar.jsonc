// VoxOS - pasek (Waybar), motyw Nord. Ikony: JetBrainsMono Nerd Font
{
    "layer": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 6,
    "modules-left": [
        "custom/arch",
        "hyprland/workspaces",
        "group/active"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/updates",
        "backlight",
        "pulseaudio",
        "network",
        "battery",
        "tray",
        "custom/power"
    ],
    "custom/arch": {
        "format": "",
        "tooltip": false,
        "on-click": "rofi -show drun"
    },
    "hyprland/workspaces": {
        "format": "{id}",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
    },
    "group/active": {
        "orientation": "horizontal",
        "modules": [
            "hyprland/window",
            "custom/close"
        ]
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 45,
        "icon": true,
        "icon-size": 16,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "$1",
            "(.*) - Visual Studio Code": "$1"
        }
    },
    "custom/close": {
        "format": "󰅖",
        "tooltip-format": "Zamknij okno (Super + Q)",
        "on-click": "hyprctl dispatch 'hl.dsp.window.close()'"
    },
    "clock": {
        "format": "󰅐  {:%H:%M}",
        "format-alt": "󰃭  {:%A, %d.%m.%Y}",
        "locale": "pl_PL.UTF-8",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<span color='#88C0D0'><b>{}</b></span>"
            }
        }
    },
    "backlight": {
        "format": "{icon}  {percent}%",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ],
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰖁  wycisz.",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ],
            "headphone": "󰋋"
        },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "network": {
        "format-wifi": "{icon}  {essid}",
        "format-icons": [
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "format-ethernet": "󰈀  LAN",
        "format-disconnected": "󰤮  offline",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "on-click": "nm-connection-editor"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰚥  {capacity}%",
        "tooltip-format": "{timeTo}"
    },
    "tray": {
        "spacing": 8,
        "icon-size": 16
    },
    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "bash ~/.local/bin/voxos-power"
    },
    "custom/updates": {
        "exec": "bash ~/.local/bin/voxos-updates",
        "return-type": "json",
        "interval": 1800,
        "format": "󰚰  {}",
        "on-click": "kitty --title Aktualizacja sh -c 'yay -Syu; pkill -RTMIN+8 waybar; echo; read -rp \"Enter zamyka okno \"'",
        "signal": 8
    }
}
