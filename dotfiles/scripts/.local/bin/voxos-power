#!/usr/bin/env bash
# VoxOS - menu zasilania (rofi, bez pola szukania). Strzałki/Enter albo mysz, Esc zamyka bez wyboru.
options=("󰌾  Zablokuj" "󰍃  Wyloguj" "󰒲  Uśpij")
[[ -f /etc/voxos/hibernate ]] && options+=("󰋊  Hibernuj")
options+=("󰜉  Uruchom ponownie" "󰐥  Wyłącz")
choice=$(printf '%s\n' "${options[@]}" | rofi -dmenu -i -no-custom -p "󰐥" \
        -theme-str "window { width: 320px; } mainbox { children: [ listview ]; } listview { lines: ${#options[@]}; }")

case "$choice" in
    *Zablokuj)         loginctl lock-session ;;
    *Wyloguj)          hyprctl dispatch 'hl.dsp.exit()' ;;
    *Uśpij)            bash ~/.local/bin/voxos-suspend ;;
    *Hibernuj)         systemctl hibernate ;;
    *"Uruchom ponownie") systemctl reboot ;;
    *Wyłącz)           systemctl poweroff ;;
esac
