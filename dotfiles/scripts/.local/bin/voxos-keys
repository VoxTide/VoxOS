#!/usr/bin/env bash
# VoxOS - ściągawka skrótów klawiszowych (Super + /)
# Wybór z listy niczego nie uruchamia - to tylko podgląd. Esc zamyka.
rofi -dmenu -i -no-custom -p "Skróty" -theme-str 'window { width: 640px; } listview { lines: 16; }' >/dev/null <<'LIST'
Super + Enter           terminal
Super + D               aplikacje
Super + E               pliki (Thunar)
Super + Q               zamknij okno (albo X na pasku)
Super + F               pełny ekran
Super + Spacja          okno pływające
Super + strzałki        fokus na sąsiednie okno
Super + Shift + strzałki    przesuń okno
Super + Ctrl + strzałki     zmień rozmiar okna
Super + 1-9             przełącz pulpit
Super + Shift + 1-9     przenieś okno na pulpit
Super + Tab             poprzedni pulpit
3 palce w bok           zmiana pulpitu (touchpad)
Super + mysz lewy/prawy przesuń / zmień rozmiar okna
Super + V               historia schowka
Print                   zrzut zaznaczenia
Shift + Print           zrzut całego ekranu
Super + N               schowaj powiadomienia
Super + Shift + N       przywróć ostatnie powiadomienie
Super + Shift + R       nagrywanie ekranu start/stop
Super + Shift + C       próbnik kolorów
Super + .               emoji
Klawisze multimedialne  muzyka: pauza, następny, poprzedni
Super + L               blokada ekranu
Super + T               wybór motywu
Super + Escape          menu zasilania
Super + Shift + E       wyloguj
Super + /               ta ściągawka
LIST
