#!/usr/bin/env bash
# VoxOS - ściągawka skrótów klawiszowych (Super + /)
# Wybór z listy niczego nie uruchamia - to tylko podgląd. Esc zamyka.
rofi -dmenu -i -no-custom -p "Skróty" -theme-str 'window { width: 640px; } listview { lines: 18; }' >/dev/null <<'LIST'
Super + Enter           terminal
Super + Shift + Enter   wysuwany terminal (pokaż / schowaj)
Super + D               aplikacje (Ctrl + Tab: kalkulator, pliki)
Super + K               kalkulator (Enter kopiuje wynik)
Super + Shift + F       szukaj plików
Alt + Tab               przełącznik okien (puść Alt, aby przełączyć)
Super + E               pliki (Thunar)
Super + Q               zamknij okno (albo X na pasku)
Super + F               pełny ekran
Super + Spacja          okno pływające
Super + strzałki        fokus na sąsiednie okno
Super + Shift + strzałki    przesuń okno
Super + Ctrl + strzałki     zmień rozmiar okna
Super + 1-9             przełącz pulpit
Super + Shift + 1-9     przenieś okno na pulpit
Super + Tab             poprzedni pulpit
3 palce w bok           zmiana pulpitu (touchpad)
Super + mysz lewy/prawy przesuń / zmień rozmiar okna
Super + Alt + ← / →     okno na lewą / prawą połowę ekranu
Super + Alt + ↑ / ↓     maksymalizuj / z powrotem do kafelków
Super + Alt + C         okno na środek
Super + H               pokaż pulpit (drugi raz: przywróć okna)
Ctrl + Shift + Esc      menedżer zadań
Super + V               historia schowka
Super + Shift + V       wyślij schowek na telefon
Spacja (w Thunarze)     szybki podgląd pliku
Super + S               panel szybkich ustawień (też klik w ikony po prawej na pasku)
Super + M               zminimalizuj okno (też klik w tytuł okna na pasku)
Super + Shift + M       przywróć zminimalizowane okno
Print                   zrzut zaznaczenia
Shift + Print           zrzut całego ekranu
Ctrl + Print            zrzut zaznaczenia od razu do edycji
Super + Shift + T       tekst z ekranu do schowka (OCR)
Super + N               schowaj powiadomienia
Super + Shift + N       przywróć ostatnie powiadomienie
Super + Shift + R       nagrywanie ekranu start/stop
Super + Shift + C       próbnik kolorów
Super + .               emoji
Klawisze multimedialne  muzyka: pauza, następny, poprzedni
Super + L               blokada ekranu
Super + T               wybór motywu
Super + Escape          menu zasilania
Super + Shift + E       wyloguj
Super + /               ta ściągawka
LIST
