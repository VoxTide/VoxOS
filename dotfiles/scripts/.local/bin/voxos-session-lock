#!/usr/bin/env bash
# VoxOS - blokada ekranu zaraz po autologinie: ekran blokady motywu pełni rolę ekranu logowania.
# Działa tylko, gdy install.sh włączył autologin (AUTOLOGIN=true). Log: $XDG_RUNTIME_DIR/voxos-session-lock.log
[[ -f /etc/sddm.conf.d/voxos-autologin.conf ]] || exit 0

log="${XDG_RUNTIME_DIR:-/tmp}/voxos-session-lock.log"
for attempt in 1 2 3 4 5; do
    echo "$(date '+%F %T') próba $attempt" >> "$log"
    # --immediate-render: tło od razu, bez czekania; --no-fade-in: bez rozjaśniania, pulpit nie mignie
    if hyprlock --immediate-render --no-fade-in >> "$log" 2>&1; then
        echo "$(date '+%F %T') odblokowano" >> "$log"
        exit 0
    fi
    sleep 1
done
notify-send -u critical -a voxos "Blokada po starcie nie zadziałała" "Szczegóły: $log"
