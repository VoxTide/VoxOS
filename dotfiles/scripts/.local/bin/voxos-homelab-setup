#!/usr/bin/env bash
# VoxOS - jednorazowe połączenie laptopa z domowymi serwerami (można uruchamiać ponownie)
#   ssh zomboid   -> EliteBook 850 G6 (serwer Project Zomboid)
#   ssh pihole    -> Acer D260 (Pi-hole)
#   pihole-web    -> panel Pi-hole w przeglądarce
# Adresy zapisuje w ~/.config/voxos/homelab.conf (poza repo), wpisy SSH w ~/.ssh/config.d/voxos.
set -uo pipefail

info() { printf '\e[1;36m==> %s\e[0m\n' "$*"; }
warn() { printf '\e[1;33m!! %s\e[0m\n' "$*"; }
ok()   { printf '\e[1;32m✓ %s\e[0m\n' "$*"; }

CONF="$HOME/.config/voxos/homelab.conf"
SSH_CONF="$HOME/.ssh/config.d/voxos"
mkdir -p "$(dirname "$CONF")" "$HOME/.ssh/config.d"
chmod 700 "$HOME/.ssh"

ZOMBOID_IP="" ZOMBOID_USER="" PIHOLE_IP="" PIHOLE_USER=""
# shellcheck source=/dev/null
[[ -f $CONF ]] && source "$CONF"

# Podpowiedź: Pi-hole jest serwerem DNS rozdawanym przez router, więc znamy jego adres
dns_hint="$(nmcli -g IP4.DNS device show 2>/dev/null | grep -m1 -E '^[0-9]+\.')"

echo "Adres IP sprawdzisz na serwerze komendą: hostname -I"
ask() { # ask <zmienna> <pytanie> <domyślna>
    local answer
    read -rp "$2 [${3}]: " answer
    printf -v "$1" '%s' "${answer:-$3}"
}
ask ZOMBOID_IP   "IP serwera zomboid (850 G6)"     "${ZOMBOID_IP:-}"
ask ZOMBOID_USER "Użytkownik na zomboid"            "${ZOMBOID_USER:-$USER}"
ask PIHOLE_IP    "IP serwera pihole (D260)"         "${PIHOLE_IP:-$dns_hint}"
ask PIHOLE_USER  "Użytkownik na pihole"             "${PIHOLE_USER:-$USER}"

cat > "$CONF" <<CONF
# VoxOS - adresy domowych serwerów (voxos-homelab-setup)
ZOMBOID_IP=$ZOMBOID_IP
ZOMBOID_USER=$ZOMBOID_USER
PIHOLE_IP=$PIHOLE_IP
PIHOLE_USER=$PIHOLE_USER
CONF

{
    echo "# VoxOS - wygenerowane przez voxos-homelab-setup"
    [[ -n $ZOMBOID_IP ]] && printf 'Host zomboid\n    HostName %s\n    User %s\n\n' "$ZOMBOID_IP" "$ZOMBOID_USER"
    [[ -n $PIHOLE_IP ]]  && printf 'Host pihole\n    HostName %s\n    User %s\n\n' "$PIHOLE_IP" "$PIHOLE_USER"
} > "$SSH_CONF"
chmod 600 "$SSH_CONF"

# ~/.ssh/config musi zaczynać się od Include, żeby wpisy z config.d działały
if ! grep -qs '^Include config.d/\*' "$HOME/.ssh/config"; then
    { echo 'Include config.d/*'; echo; cat "$HOME/.ssh/config" 2>/dev/null; } > "$HOME/.ssh/config.new"
    mv "$HOME/.ssh/config.new" "$HOME/.ssh/config"
fi
chmod 600 "$HOME/.ssh/config"
ok "Zapisano wpisy SSH: zomboid, pihole"

if [[ ! -f $HOME/.ssh/id_ed25519 ]]; then
    info "Tworzę klucz SSH (Enter = bez hasła do klucza)"
    ssh-keygen -t ed25519 -C "$USER@$(cat /etc/hostname)" -f "$HOME/.ssh/id_ed25519"
fi

for host in zomboid pihole; do
    grep -q "^Host $host$" "$SSH_CONF" || continue
    if ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" true 2>/dev/null; then
        ok "$host: logowanie kluczem działa"
        continue
    fi
    info "$host: kopiuję klucz (raz podaj hasło użytkownika na serwerze)"
    if ssh-copy-id -o ConnectTimeout=5 "$host"; then
        ok "$host: od teraz bez hasła - wpisz: ssh $host"
    else
        warn "$host: nie udało się połączyć. Czy serwer jest włączony i ma serwer SSH (sudo apt install openssh-server)?"
    fi
done
