#!/usr/bin/env bash
# VoxOS - zrzut ekranu: zapis do Obrazy/Zrzuty, kopia do schowka, powiadomienie z podglądem
# Użycie: voxos-screenshot area | full
set -u
dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Obrazy")/Zrzuty"
mkdir -p "$dir"
file="$dir/$(date +%F_%H-%M-%S).png"
n=2
while [[ -e $file ]]; do file="$dir/$(date +%F_%H-%M-%S)_$n.png"; n=$((n + 1)); done

case "${1:-area}" in
    area) geom="$(slurp)" || exit 0          # Esc przy zaznaczaniu = anuluj
          grim -g "$geom" "$file" ;;
    full) grim "$file" ;;
    *)    echo "Użycie: voxos-screenshot area|full" >&2; exit 1 ;;
esac

[[ -f $file ]] || exit 1
wl-copy < "$file"
notify-send -a voxos-screenshot -i "$file" "Zrzut ekranu" "Skopiowano do schowka"$'\n'"$(basename "$file")"
