#!/usr/bin/env bash
# VoxOS - telefon przez KDE Connect
#   voxos-phone clip          wyślij schowek laptopa na telefon (Super + Shift + V)
#   voxos-phone share PLIKI   wyślij pliki na telefon (Thunar: prawy klik -> Wyślij na telefon)
#   voxos-phone pick          okno wyboru plików, potem wysyłka (panel: Telefon -> Wyślij pliki)
#   voxos-phone ring          telefon dzwoni, nawet wyciszony (szukanie telefonu)
#   voxos-phone info          JSON: nazwa, bateria, ładowanie (dla panelu)
# Schowek telefon -> laptop: na telefonie w powiadomieniu KDE Connect "Wyślij schowek".
set -u
note() { notify-send -a "KDE Connect" -i kdeconnect "$@" 2>/dev/null || true; }

device() {   # pierwsze dostępne (sparowane i w zasięgu) urządzenie: "id nazwa"
    kdeconnect-cli -a --id-name-only 2>/dev/null | head -1
}

read -r id name < <(device; echo)
if [[ -z ${id:-} ]]; then
    [[ ${1:-} == info ]] && { echo '{}'; exit 0; }
    note "Telefon niedostępny" "Włącz KDE Connect na telefonie i połącz się z tą samą siecią Wi-Fi"
    exit 1
fi

case "${1:-}" in
    clip)
        kdeconnect-cli -d "$id" --send-clipboard && note "Wysłano schowek" "na: $name" ;;
    share)
        shift
        n=0
        for f in "$@"; do
            [[ -e $f ]] || continue
            kdeconnect-cli -d "$id" --share "$f" && n=$((n + 1))
        done
        (( n > 0 )) && note "Wysłano na telefon" "$name: plików $n" ;;
    pick)
        mapfile -t files < <(python3 - <<'PY'
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk
d = Gtk.FileChooserDialog(title="Wyślij na telefon", action=Gtk.FileChooserAction.OPEN)
d.add_buttons("Anuluj", Gtk.ResponseType.CANCEL, "Wyślij", Gtk.ResponseType.OK)
d.set_select_multiple(True)
if d.run() == Gtk.ResponseType.OK:
    print("\n".join(d.get_filenames()))
PY
        )
        (( ${#files[@]} > 0 )) && exec bash "$0" share "${files[@]}" ;;
    ring)
        kdeconnect-cli -d "$id" --ring && note "Telefon dzwoni" "$name" ;;
    info)
        path="/modules/kdeconnect/devices/$id/battery"
        charge=$(busctl --user get-property org.kde.kdeconnect "$path" org.kde.kdeconnect.device.battery charge 2>/dev/null | awk '{print $2}')
        charging=$(busctl --user get-property org.kde.kdeconnect "$path" org.kde.kdeconnect.device.battery isCharging 2>/dev/null | awk '{print $2}')
        jq -cn --arg name "$name" --arg charge "${charge:-}" --arg charging "${charging:-}" \
            '{name: $name, battery: ($charge | tonumber? // null), charging: ($charging == "true")}' ;;
    *)
        echo "Użycie: voxos-phone clip|share PLIKI|pick|ring|info" >&2; exit 1 ;;
esac
