#!/usr/bin/env bash
# VoxOS - nagrywanie ekranu (wf-recorder). Super+Shift+R: start (zaznacz obszar, Enter/klik = cały ekran), ponownie: stop.
# Pliki trafiają do Wideo/Nagrania jako mp4.
set -u
if pgrep -x wf-recorder >/dev/null; then
    pkill -INT -x wf-recorder                 # SIGINT = poprawne zamknięcie pliku
    notify-send -a voxos-record "󰓛  Nagrywanie zakończone" "Zapisano w Wideo/Nagrania"
    exit 0
fi

dir="$(xdg-user-dir VIDEOS 2>/dev/null || echo "$HOME/Wideo")/Nagrania"
mkdir -p "$dir"
file="$dir/$(date +%F_%H-%M-%S).mp4"

geom="$(slurp 2>/dev/null)" || geom=""     # Esc przy zaznaczaniu = cały ekran
notify-send -a voxos-record -t 2000 "󰑋  Nagrywanie" "Super + Shift + R kończy nagranie"
if [[ -n $geom ]]; then
    wf-recorder -g "$geom" -f "$file" >/dev/null 2>&1 &
else
    wf-recorder -f "$file" >/dev/null 2>&1 &
fi
